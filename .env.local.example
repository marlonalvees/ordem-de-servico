# Supabase — Settings > API no dashboard do projeto
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mesmo valor usado pelo servidor do hub-novamix (server/.env -> JWT_SECRET)
JWT_SECRET=

# URL de login do hub, usada quando não há cookie válido
HUB_LOGIN_URL=https://hub.lojanovamix.com.br/login

# Opcional — base URL da API do hub (usada só para buscar o nome real de
# quem assume um chamado via GET /users/me). Sem isso, o painel mostra
# "Usuário #<id>" no lugar do nome.
HUB_API_URL=
